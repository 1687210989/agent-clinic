{
  "name": "agent-clinic",
  "version": "0.2.0-rc.2",
  "description": "Agent 体检诊所 —— 用可复核证据诊断 Agent 使用体验问题，并开出可执行处方",
  "type": "module",
  "main": "plugin/index.js",
  "exports": {
    ".": "./plugin/index.js",
    "./client": "./plugin/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./src/*": "./src/*"
  },
  "bin": {
    "agent-clinic": "./src/cli.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "scan": "node src/cli.mjs scan",
    "report": "node src/cli.mjs report",
    "smoke": "node scripts/smoke.mjs",
    "test:plugin": "node scripts/plugin-dom.test.mjs",
    "fixtures": "node scripts/fixtures/synth-dsh.mjs --out .tmp/synth-home",
    "fixtures:verify": "node scripts/fixtures/synth-dsh.mjs --verify",
    "fingerprints": "node src/cli.mjs fingerprints",
    "publish:npm": "node scripts/publish-npm.mjs",
    "publish:npm:go": "node scripts/publish-npm.mjs --publish"
  },
  "files": [
    "plugin",
    "src",
    "docs",
    "scripts",
    "cordis.patch.yml",
    "SKILL.md",
    "README.md",
    "LICENSE",
    "install.sh"
  ],
  "keywords": [
    "agent",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "diagnostics",
    "token-cost",
    "skill"
  ],
  "license": "MIT",
  "dependencies": {},
  "private": false
}
